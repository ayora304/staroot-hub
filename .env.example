# Appwrite server API
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=staroot_hub
APPWRITE_BUCKET_ATTACHMENTS=attachments
# Share the private attachments bucket when the Appwrite plan limits bucket count
APPWRITE_BUCKET_PROOFS=attachments

# Authentication and local development
ALLOWED_EMAIL_DOMAIN=staroot.example
DEFAULT_CURRENCY=KES
VITE_API_BASE=/api
API_DEV_TARGET=http://localhost:3001

# Web Push (generate a VAPID pair; keep the private key secret)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@staroot.example

# Public value must match the server VAPID pair
VITE_VAPID_PUBLIC_KEY=
