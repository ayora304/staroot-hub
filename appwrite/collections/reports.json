{
  "id": "reports",
  "name": "reports",
  "purpose": "Pending project reports become immutable final snapshots after manager approval.",
  "attributes": [
    {
      "key": "client_id",
      "type": "string",
      "required": true,
      "note": "Idempotency key, unique"
    },
    {
      "key": "title",
      "type": "string",
      "required": true,
      "note": ""
    },
    {
      "key": "report_date",
      "type": "datetime",
      "required": true,
      "note": ""
    },
    {
      "key": "author_id",
      "type": "string",
      "required": true,
      "note": ""
    },
    {
      "key": "author_name",
      "type": "string",
      "required": true,
      "note": ""
    },
    {
      "key": "schema_version",
      "type": "int",
      "required": true,
      "note": ""
    },
    {
      "key": "snapshot",
      "type": "text",
      "required": true,
      "note": "JSON: disclaimer + projects[].sections[] (title, bullets[], photo file IDs). Use longtext/mediumtext attribute"
    },
    {
      "key": "status",
      "type": "enum[pending,final,published,superseded]",
      "required": true,
      "note": ""
    },
    { "key": "approved_by", "type": "string", "required": false },
    { "key": "approved_at", "type": "datetime", "required": false }
  ],
  "indexes": [
    {
      "key": "uq_client",
      "type": "unique",
      "attributes": [
        "client_id"
      ]
    },
    {
      "key": "ix_date",
      "type": "key",
      "attributes": [
        "report_date"
      ]
    }
  ],
  "permissions_note": "API only. Authors may edit pending reports. A different manager approves within read scope. Final and legacy published content is immutable."
}
